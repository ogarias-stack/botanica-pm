# Python 3.12. Copia este archivo a .env y configura una base de pruebas.
# python -m pip install -r requirements.txt
#
# Genera las claves de desarrollo y copia el resultado de openssl rand a DEV_TOKEN_SECRET.
# mkdir -p keys
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out keys/jwt-private.pem
# openssl pkey -in keys/jwt-private.pem -pubout -out keys/jwt-public.pem
# openssl rand -hex 32
#
# 1. python init_db.py
# 2. psql "$POSTGRES_DSN" -v ON_ERROR_STOP=1 -f migracion_semana3.sql
# 3. python seed_semana3.py
# 4. uvicorn main:app
# Para psql exporta POSTGRES_DSN o sustituye la variable por la URL postgresql://.
# POST /auth/token exige X-Dev-Token-Secret. Usa después Authorization: Bearer <token>.

APP_ENV=development
DEV_TOKEN_SECRET=
JWT_PRIVATE_KEY_FILE=keys/jwt-private.pem
JWT_PUBLIC_KEY_FILE=keys/jwt-public.pem
JWT_ISSUER=botanica-pm-dev
JWT_AUDIENCE=botanica-pm-api
OLI_ACTOR_ID=oli-dev
# IDs del equipo técnico, separados por comas. Roles JWT: jefe_obra o ingeniero_residente.
BOTANICA_EQUIPO_IDS=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=postgresql+psycopg://botanica:REEMPLAZA_PASSWORD@localhost:5432/botanica
POSTGRES_DSN=postgresql://botanica:REEMPLAZA_PASSWORD@localhost:5432/botanica

# La evaluación encola alertas. Configura un webhook de prueba antes de iniciar el proceso de envío.
# python -c "from agente import procesar_alertas; procesar_alertas()"
ALERTAS_WEBHOOK_URL=
ALERTAS_WEBHOOK_TOKEN=
ALERTAS_HORAS_ACUSE=24
OLI_ALERTA_EMAIL=
OLI_ALERTA_WHATSAPP=
